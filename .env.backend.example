APP_ENV=development
APP_DEBUG=true
API_PREFIX=/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:5176,http://127.0.0.1:5173,http://127.0.0.1:5176

# Compose/Postgres values
SERVER_API_PORT=18087
POSTGRES_USER=budgii
POSTGRES_PASSWORD=budgii
POSTGRES_DB=budgii
DATABASE_URL=postgresql+asyncpg://budgii:budgii@db:5432/budgii
BUDGII_DEV_SEED=true
BUDGII_RUN_MIGRATIONS=false

# Generate a strong secret with: openssl rand -hex 32
JWT_SECRET=change-me-in-development
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

APPLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
OPENAI_API_KEY=
AI_INSIGHTS_MODEL=gpt-5.4-mini

INVITE_LINK_BASE=https://budgii.com.au/join
AUTH_LINK_BASE=http://localhost:5173
INVITE_EMAIL_PROVIDER=log
INVITE_EMAIL_FROM=
INVITE_EMAIL_API_KEY=

RECEIPT_STORAGE_PATH=/app/uploads
RECEIPT_OCR_PROVIDER=deterministic
RECEIPT_OPENAI_MODEL=gpt-5.5

PUSH_PROVIDER=log
FCM_PROJECT_ID=
# Download this JSON from Firebase Console → Project settings → Service accounts.
# Set this to its local path, for example: /absolute/path/firebase-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=

# Worker cadence used by staging/production Compose stacks.
RECURRING_WORKER_INTERVAL_SECONDS=3600
PUSH_WORKER_INTERVAL_SECONDS=300
