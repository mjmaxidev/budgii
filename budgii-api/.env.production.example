APP_ENV=production
APP_DEBUG=false
API_PREFIX=/v1

# Docker Compose server ports. These intentionally avoid common local ports.
SERVER_API_PORT=28087
SERVER_FRONTEND_PORT=28088

# Frontend build-time API URL. For a real domain, use your public API origin.
PUBLIC_API_BASE_URL=https://budgii-api.mxjprod.work/v1
VITE_SHOW_DEMO_TOOLS=false

# Browser/app origins allowed to call the API when APP_DEBUG=false.
# Include your production web origin and any mobile webview origins you ship.
CORS_ORIGINS=http://localhost:28088,http://127.0.0.1:28088,https://budgii.mxjprod.work,https://budgii.app,capacitor://localhost

# Managed Postgres connection string from Fly.io, Railway, ECS/RDS, etc.
DATABASE_URL=postgresql+asyncpg://budgii:PASSWORD@HOST:5432/budgii

# Local single-server Docker Compose Postgres credentials.
POSTGRES_USER=budgii
POSTGRES_PASSWORD=replace-with-generated-postgres-password
POSTGRES_DB=budgii

# Generate with:
#   openssl rand -hex 32
JWT_SECRET=replace-with-generated-64-character-hex-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# OAuth token verification. Fill after creating production OAuth clients.
APPLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# OpenAI receipt understanding. Create a backend API key at:
#   https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Join links sent in household invite emails.
INVITE_LINK_BASE=https://budgii.app/join

# Email invite delivery.
# Default to log so the server stack can boot before email credentials exist.
# Resend:   create a key at https://resend.com/api-keys
# SendGrid: create a key at https://app.sendgrid.com/settings/api_keys
INVITE_EMAIL_PROVIDER=log
INVITE_EMAIL_FROM=
INVITE_EMAIL_API_KEY=

# Receipt image storage. For single-host deploys, mount a persistent disk here.
RECEIPT_STORAGE_PATH=/app/uploads
RECEIPT_OCR_PROVIDER=openai
RECEIPT_OPENAI_MODEL=gpt-5.5

# Push notification delivery. `log` is safe until APNs/FCM credentials are wired.
PUSH_PROVIDER=log

# Background worker cadence for Docker Compose server stacks.
RECURRING_WORKER_INTERVAL_SECONDS=3600
PUSH_WORKER_INTERVAL_SECONDS=300
