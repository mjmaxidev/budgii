APP_ENV=development
APP_DEBUG=true
API_PREFIX=/v1
# Comma-separated browser/app origins allowed to call the API when APP_DEBUG=false.
# Production example: CORS_ORIGINS=https://budgii.app,capacitor://localhost
CORS_ORIGINS=http://localhost:5173,http://localhost:5176,http://127.0.0.1:5173,http://127.0.0.1:5176

# Local dev (python on host, postgres in docker: docker compose up db)
DATABASE_URL=postgresql+asyncpg://budgii:budgii@localhost:5432/budgii

# Docker Compose (api service uses hostname `db`)
# DATABASE_URL=postgresql+asyncpg://budgii:budgii@db:5432/budgii

# Generate a production JWT secret with:
#   openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Apple / Google token verification (fill when wiring mobile auth)
# Apple: create an app/service identifier in the Apple Developer portal, then paste the client ID here.
# Google: create an OAuth client in Google Cloud Console, then paste the client ID here.
APPLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# OpenAI receipt understanding (backend only; never expose this to the frontend)
# 1. Create an API key at https://platform.openai.com/api-keys
# 2. Copy this file to `.env`
# 3. Paste the key below as OPENAI_API_KEY=sk-...
OPENAI_API_KEY=

INVITE_LINK_BASE=https://budgii.app/join
# Email invite delivery.
# Development default logs the invite URL without sending email.
# Production options:
#   INVITE_EMAIL_PROVIDER=resend   # create a key at https://resend.com/api-keys
#   INVITE_EMAIL_PROVIDER=sendgrid # create a key at https://app.sendgrid.com/settings/api_keys
INVITE_EMAIL_PROVIDER=log
INVITE_EMAIL_FROM=
INVITE_EMAIL_API_KEY=
RECEIPT_STORAGE_PATH=/app/uploads
# Keep deterministic for local/dev. Switch to openai after the OpenAI provider is implemented.
RECEIPT_OCR_PROVIDER=deterministic
# RECEIPT_OCR_PROVIDER=openai
# Pick the OpenAI vision model used by the receipt provider when RECEIPT_OCR_PROVIDER=openai.
RECEIPT_OPENAI_MODEL=gpt-5.5
