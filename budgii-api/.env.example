APP_ENV=development
APP_DEBUG=true
API_PREFIX=/v1

# Local dev (python on host, postgres in docker: docker compose up db)
DATABASE_URL=postgresql+asyncpg://budgii:budgii@localhost:5432/budgii

# Docker Compose (api service uses hostname `db`)
# DATABASE_URL=postgresql+asyncpg://budgii:budgii@db:5432/budgii

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Apple / Google token verification (fill when wiring mobile auth)
APPLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

INVITE_LINK_BASE=https://budgii.app/join
RECEIPT_STORAGE_PATH=/app/uploads
