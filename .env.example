# Set to "true" to sync with the Budgii API instead of localStorage-only mode.
VITE_API_ENABLED=false

# FastAPI dev server (docker compose in budgii-api/)
VITE_API_BASE_URL=http://localhost:8001/v1

# Shows prototype/demo-only tools such as "Reset Demo Data" in Settings.
VITE_SHOW_DEMO_TOOLS=false

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
